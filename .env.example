# Public contact details: confirm with the owner before launch.
NEXT_PUBLIC_SITE_URL=https://the-pookie-craft-co.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_INSTAGRAM_HANDLE=thepookiecraft
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/thepookiecraft/
NEXT_PUBLIC_EMAIL=

# Server-only owner credentials. No public registration.
ADMIN_EMAIL=
# Generate with npm run admin:password (salt:hash). Never store a plaintext password.
ADMIN_PASSWORD_HASH=
# Random secret, at least 32 characters. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional in development; required for production writes and request storage.
# Upstash-compatible Redis REST endpoint and token, controlled by the owner.
CONTENT_REDIS_URL=
CONTENT_REDIS_TOKEN=
